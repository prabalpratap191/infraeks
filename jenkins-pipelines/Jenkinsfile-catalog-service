// Jenkins Pipeline for Catalog Service
pipeline {
    agent any
    
    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest')
        string(name: 'CLUSTER_NAME', defaultValue: 'meracommerce-dev-cluster')
        string(name: 'AWS_REGION', defaultValue: 'us-east-1')
        string(name: 'NAMESPACE', defaultValue: 'catalog-service-ns')
        string(name: 'ECR_REPOSITORY', defaultValue: 'catalog-service')
    }
    
    environment {
        AWS_DEFAULT_REGION = "${params.AWS_REGION}"
        SERVICE_NAME = "catalog-service"
        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${params.AWS_REGION}.amazonaws.com"
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build & Test') {
            steps {
                sh 'mvn clean package'
            }
        }
        
        stage('Build & Push Docker Image') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'jenkins-user',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    sh '''
                        aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}
                        docker build -t ${SERVICE_NAME}:${IMAGE_TAG} .
                        docker tag ${SERVICE_NAME}:${IMAGE_TAG} ${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}
                        docker push ${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}
                    '''
                }
            }
        }
        
        stage('Deploy to EKS') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'jenkins-user',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    sh '''
                        aws eks update-kubeconfig --name ${CLUSTER_NAME} --region ${AWS_REGION}
                        export ECR_REGISTRY=${ECR_REGISTRY}
                        export IMAGE_TAG=${IMAGE_TAG}
                        envsubst < k8s-manifests/catalog-service/deployment.yaml | kubectl apply -f -
                        kubectl rollout status deployment/catalog-service -n ${NAMESPACE} --timeout=5m
                    '''
                }
            }
        }
    }
}
